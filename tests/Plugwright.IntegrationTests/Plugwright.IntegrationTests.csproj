<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestPluginsPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/test-plugins/$(Configuration)/'))</TestPluginsPath>
    <RestartHostPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/restart-host/$(Configuration)/'))</RestartHostPath>
    <PublishedPluginsPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/published-plugins/$(Configuration)/'))</PublishedPluginsPath>
    <TestPackagesPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/test-packages/$(Configuration)/'))</TestPackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plugwright\Plugwright.csproj" />
    <ProjectReference Include="..\..\src\Plugwright.Cli\Plugwright.Cli.csproj" />
    <ProjectReference Include="..\..\src\Plugwright.NuGet\Plugwright.NuGet.csproj" />
    <ProjectReference Include="..\..\src\Plugwright.AspNetCore\Plugwright.AspNetCore.csproj" />
    <ProjectReference Include="..\TestWebHost\TestWebHost.csproj" />
    <!-- The host's copy of TextLib (2.0), while the Greeter plugin ships 1.0: tests for shared assemblies. -->
    <ProjectReference Include="..\TestPlugins\TextLibV2\TextLibV2.csproj" />
  </ItemGroup>

  <!-- Samples tested with WebApplicationFactory<Program>. Aliases keep their Program classes apart. -->
  <ItemGroup>
    <ProjectReference Include="..\..\samples\WebHost\App\WebHost.App.csproj" Aliases="WebHostSample" />
    <ProjectReference Include="..\..\samples\BlazorHost\App\BlazorHost.App.csproj" Aliases="BlazorHostSample" />
    <ProjectReference Include="..\..\samples\SplitHosts\Api\SplitHosts.Api.csproj" Aliases="SplitHostsApiSample" />
  </ItemGroup>

  <!-- Build the test plugins first, but never reference them: the tests load them like real plugins. -->
  <ItemGroup>
    <ProjectReference Include="..\RestartHost\RestartHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\Greeter\Greeter.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\Counter\Counter.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\NoPlugins\NoPlugins.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\Logging\Logging.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\Audit\Audit.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\NeedsNewLogging\NeedsNewLogging.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\CycleA\CycleA.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\CycleB\CycleB.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\Web\Web.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\AuditReport\AuditReport.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\Faulty\Faulty.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPlugins\OptionalAudit\OptionalAudit.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPackages\LibraryV1\LibraryV1.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPackages\LibraryV2\LibraryV2.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPackages\Greeter\Greeter.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPackages\Reports\Reports.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPackages\AssetsLibrary\AssetsLibrary.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\TestPackages\BlazorAssets\BlazorAssets.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestPluginsPath</_Parameter1>
      <_Parameter2>$(TestPluginsPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PublishedPluginsPath</_Parameter1>
      <_Parameter2>$(PublishedPluginsPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RestartHostPath</_Parameter1>
      <_Parameter2>$(RestartHostPath)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestPackagesPath</_Parameter1>
      <_Parameter2>$(TestPackagesPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- Plugins with static web assets must be published; the build output lacks the asset files. -->
  <Target Name="PublishTestPlugins" AfterTargets="Build">
    <MSBuild Projects="..\TestPackages\BlazorAssets\BlazorAssets.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);GeneratePackageOnBuild=false;PublishDir=$(PublishedPluginsPath)Plugwright.TestPackages.BlazorAssets/" />
  </Target>

</Project>
