@page "/orders"
@rendermode InteractiveServer
@inject OrderBook OrderBook

<PageTitle>Orders</PageTitle>

@* A static file of the plugin, served from _content/<assembly name>/ *@
<HeadContent>
    <link rel="stylesheet" href="_content/Acme.Orders.Ui/orders.css" />
</HeadContent>

<h1>Orders</h1>

<table class="orders">
    <thead>
        <tr><th>Number</th><th>Product</th><th>Status</th></tr>
    </thead>
    <tbody>
        @foreach (var order in OrderBook.Orders)
        {
            <tr>
                <td>@order.Number</td>
                <td>@order.Product</td>
                <td>
                    @if (order.Shipped)
                    {
                        <span class="shipped">Shipped</span>
                    }
                    else
                    {
                        <button @onclick="() => OrderBook.Ship(order.Number)">Ship</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
