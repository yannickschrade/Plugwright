<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Plugwright\Plugwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    For the sample only: build the plugin and copy its output to plugins/Acme.Greeter/ next to the app.
    The app does not reference the plugin. In production, deploy plugins with
    "dotnet publish Acme.Greeter -o <app>/plugins/Acme.Greeter".
  -->
  <ItemGroup>
    <ProjectReference Include="..\Acme.Greeter\Acme.Greeter.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <ItemGroup>
      <SamplePluginFile Include="..\Acme.Greeter\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFile)"
          DestinationFiles="@(SamplePluginFile->'$(OutDir)plugins\Acme.Greeter\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
