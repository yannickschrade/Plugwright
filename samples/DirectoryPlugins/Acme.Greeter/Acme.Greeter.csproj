<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Copy all dependencies into the build output, so the output can be deployed as a plugin folder. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the plugin contract, but do not ship it: the host provides it. -->
    <ProjectReference Include="..\..\..\src\Plugwright.Abstractions\Plugwright.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* also come from the host at runtime, whatever version the plugin ships. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
