<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Plugwright\Plugwright.csproj" />
    <ProjectReference Include="..\Contracts\SharedAssemblies.Contracts.csproj" />
  </ItemGroup>

  <!--
    For the sample only: build the plugin and copy its output to plugins/Acme.Uptime/ next to the app.
    The app does not reference the plugin.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Acme.Uptime\Acme.Uptime.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <ItemGroup>
      <SamplePluginFile Include="..\Acme.Uptime\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFile)"
          DestinationFiles="@(SamplePluginFile->'$(OutDir)plugins\Acme.Uptime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
