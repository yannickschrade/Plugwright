<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Plugwright\Plugwright.csproj" />
  </ItemGroup>

  <!--
    For the sample only: build the plugins and copy their output to plugins/<Name>/ next to the app.
    The app references none of them.
  -->
  <ItemGroup>
    <SamplePlugin Include="Acme.Formatting;Acme.Welcome;Acme.Farewell" />
    <ProjectReference Include="@(SamplePlugin->'..\%(Identity)\%(Identity).csproj')" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopySamplePlugins" AfterTargets="Build">
    <ItemGroup>
      <SamplePluginFile Include="..\%(SamplePlugin.Identity)\bin\$(Configuration)\$(TargetFramework)\**\*">
        <Plugin>%(SamplePlugin.Identity)</Plugin>
      </SamplePluginFile>
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFile)"
          DestinationFiles="@(SamplePluginFile->'$(OutDir)plugins\%(Plugin)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
