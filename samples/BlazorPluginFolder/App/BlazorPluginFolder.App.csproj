<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Plugwright.AspNetCore\Plugwright.AspNetCore.csproj" />
  </ItemGroup>

  <!--
    dotnet build -p:PluginsAsProjects=true references the plugin as a project, for debugging and Hot Reload.
    Otherwise the plugin is published to plugins/ next to the app, as it is deployed. Never both: a plugin loaded from a
    folder must not be referenced, not even with ReferenceOutputAssembly="false", or the SDK adds its static web assets
    to the app's own.
  -->
  <PropertyGroup Condition="'$(PluginsAsProjects)' == 'true'">
    <DefineConstants>$(DefineConstants);PLUGINS_AS_PROJECTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PluginsAsProjects)' == 'true'">
    <ProjectReference Include="..\Acme.Weather.Ui\Acme.Weather.Ui.csproj" />
  </ItemGroup>

  <Target Name="PublishPlugins" AfterTargets="Build" Condition="'$(PluginsAsProjects)' != 'true'">
    <MSBuild Projects="..\Acme.Weather.Ui\Acme.Weather.Ui.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(MSBuildProjectDirectory)\$(OutDir)plugins\Acme.Weather.Ui\" />
  </Target>

</Project>
