<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Plugwright.AspNetCore\Plugwright.AspNetCore.csproj" />
  </ItemGroup>

  <!--
    For the sample only: publish the plugin to plugins/Acme.Weather.Ui/ next to the app. Plugins with static web assets
    must be published: the build output lacks the asset files. The app must not reference the plugin project, not even
    with ReferenceOutputAssembly="false": the SDK would add the plugin's assets to the app's own, pointing to the
    plugin's source folder.
  -->

  <Target Name="PublishSamplePlugin" AfterTargets="Build">
    <MSBuild Projects="..\Acme.Weather.Ui\Acme.Weather.Ui.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(MSBuildProjectDirectory)\$(OutDir)plugins\Acme.Weather.Ui\" />
  </Target>

</Project>
