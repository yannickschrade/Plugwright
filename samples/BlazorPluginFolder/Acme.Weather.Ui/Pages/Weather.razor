@page "/weather"

@* --8<-- [start:page] *@
@* Assets of the plugin are below _content/{PluginId}/, as for a project reference.
   @Assets returns the fingerprinted route, which browsers may cache for a year. *@
<h1 class="title">Weather</h1>
<img src="@Assets["_content/Acme.Weather.Ui/sun.svg"]" alt="Sun" width="64" height="64" />
<p class="forecast">Sunny, 24 °C.</p>
@* --8<-- [end:page] *@
