@inject IPluginCatalog Catalog

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <nav>
        <a href="">Home</a>
        @* The link only appears when the UI plugin is loaded. *@
        @if (Catalog.Find("Acme.Orders.Ui")?.State == PluginState.Loaded)
        {
            <text> | </text><a href="orders">Orders</a>
        }
    </nav>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
