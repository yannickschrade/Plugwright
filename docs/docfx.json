{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Plugwright.Abstractions/Plugwright.Abstractions.csproj",
            "Plugwright/Plugwright.csproj",
            "Plugwright.NuGet/Plugwright.NuGet.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.{md,yml}" ],
        "exclude": [ "_site/**", "design/**", "obj/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "xref": [ "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json" ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Plugwright",
      "_appTitle": "Plugwright",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
