<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unnecessary usings) in the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Yannick Schrade</Authors>
    <Copyright>Copyright (c) Yannick Schrade</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>plugins;plugin-system;generic-host;hosting;dependency-injection</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
